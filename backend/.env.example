# =============================================================================
# CareerTwin AI — Backend Environment Configuration
# =============================================================================

# Server settings
APP_NAME=CareerTwin AI Backend
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Security & Authentication
# IMPORTANT: Generate a secure secret in production (e.g. openssl rand -hex 32)
SECRET_KEY=careertwin-development-insecure-secret-key-change-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database — SQLite relative to backend/
DATABASE_URL=sqlite:///./data/careertwin.db

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000
