# =============================================================================
# CareerTwin AI — Backend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file with secrets to Git.
# =============================================================================

# Server settings
APP_NAME=CareerTwin AI Backend
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Security & Authentication
# IMPORTANT: Generate a secure secret in production (e.g. openssl rand -hex 32)
SECRET_KEY=careertwin-development-insecure-secret-key-change-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database — SQLite relative to backend/
DATABASE_URL=sqlite:///./data/careertwin.db

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000

# Optional GitHub Token to increase rate limits (60/hr unauthenticated -> 5000/hr)
GITHUB_TOKEN=

# =============================================================================
# Google OAuth 2.0 Authentication Settings
# =============================================================================
# Obtain credentials from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173

# =============================================================================
# External Job Provider API Settings (Adzuna, Remotive, Arbeitnow)
# =============================================================================
# Adzuna API credentials (https://developer.adzuna.com/)
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
ADZUNA_COUNTRY=in

# =============================================================================
# AI Career Assistant Settings (Multi-Model LLM or Built-in Deterministic)
# =============================================================================
# Supported AI_PROVIDER: 'none' (deterministic rules engine), 'gemini', 'openai', 'groq', 'ollama'
AI_PROVIDER=none
AI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gemini-3-flash-preview
AI_BASE_URL=
AI_TIMEOUT_SECONDS=45.0
AI_MAX_TOKENS=3500
