# =============================================================================
# CareerTwin AI — Root Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file with secrets to Git.
# =============================================================================

# APPLICATION
APP_NAME=CareerTwin AI
APP_ENV=development
DEBUG=True

# BACKEND — FastAPI Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
SECRET_KEY=careertwin-development-insecure-secret-key-change-in-production-12345
ALLOWED_ORIGINS=http://localhost:5173

# FRONTEND — React / Vite
VITE_API_BASE_URL=http://localhost:8000/api/v1

# DATABASE
DATABASE_URL=sqlite:///./data/careertwin.db

# OPTIONAL GITHUB TOKEN
GITHUB_TOKEN=

# GOOGLE OAUTH 2.0 AUTHENTICATION
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173

# EXTERNAL JOB APIS (Adzuna, Remotive, Arbeitnow)
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
ADZUNA_COUNTRY=in

# AI CAREER ASSISTANT SETTINGS
# Supported AI_PROVIDER: 'none' (deterministic rules engine), 'gemini', 'openai', 'groq', 'ollama'
AI_PROVIDER=none
AI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gemini-3-flash-preview
AI_BASE_URL=
AI_TIMEOUT_SECONDS=45.0
AI_MAX_TOKENS=3500
