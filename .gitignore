# =============================================================================
# CareerTwin AI — .gitignore
# Covers: React/Vite, Node.js, Python, FastAPI, virtualenv,
#         environment variables, IDE files, OS files, logs, builds
# =============================================================================


# =============================================================================
# ENVIRONMENT VARIABLES — Never commit real secrets
# =============================================================================
.env
.env.local
.env.development
.env.production
.env.test
*.env


# =============================================================================
# PYTHON
# =============================================================================

# Bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
venv/
.venv/
env/
.env/
ENV/
virtualenv/
.virtualenvs/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
*.whl
MANIFEST

# Testing
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# Jupyter Notebooks checkpoints
.ipynb_checkpoints/

# pyenv
.python-version

# pipenv / poetry
Pipfile.lock
poetry.lock


# =============================================================================
# NODE.JS / REACT / VITE
# =============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
out/
.vite/

# Cache
.cache/
.parcel-cache/
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Lock files (keep package-lock.json or yarn.lock — not both)
# Uncomment the one you are NOT using:
# package-lock.json
# yarn.lock


# =============================================================================
# LOGS
# =============================================================================
logs/
*.log
*.log.*
log/


# =============================================================================
# DATABASE FILES
# =============================================================================
*.sqlite
*.sqlite3
*.db


# =============================================================================
# ML — Model artifacts & data
# =============================================================================
*.pkl
*.joblib
*.h5
*.pt
*.pth
*.onnx
data/raw/
data/processed/


# =============================================================================
# IDE & EDITOR FILES
# =============================================================================

# VS Code
.vscode/
*.code-workspace

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Neovim
*.swp
*.swo
*~

# Emacs
\#*\#
.\#*


# =============================================================================
# OPERATING SYSTEM FILES
# =============================================================================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~


# =============================================================================
# MISC
# =============================================================================
*.bak
*.tmp
*.temp
*.orig
